     .out_rgb(scale_rgb), .out_last(scale_last),
     .out_frame_last(scale_frame_last)
 );
 
+always @(posedge clk or posedge rst) begin
+    if (rst)
+        zoom_output_gap <= 1'b0;
+    else if (frame_start)
+        zoom_output_gap <= 1'b0;
+    else
+        zoom_output_gap <= PACE_ZOOM_OUTPUT && zoom_latched && out_valid && out_ready;
+end
+
 always @(posedge clk or posedge rst) begin
     if (rst) begin
         zoom_latched <= 0;
